class_name Lore
extends RefCounted
## The world beyond the rules: thirty archetypes across the regions in Data.REGIONS, for the Codex and for future heroes.
## Each names its region, element, role, favoured aptitudes, a hook, an idea for how it plays on the grid
## (`plays`, a design note, not yet a rule) and the real tradition it draws on. `hero` links the ones already playable.

const ROLES := {
	"striker": "Deals the damage.",
	"guardian": "Holds the front and protects.",
	"healer": "Mends and cleanses.",
	"controller": "Moves, binds and reorders enemies.",
	"support": "Lifts allies: shields, buffs, turn order.",
	"skirmisher": "Moves and strikes where it hurts.",
}

const ARCHETYPES := [
